# Cursor agent webhook (from Cursor → Agents → your bot → Webhooks)
CURSOR_WEBHOOK_URL=https://api.cursor.com/v0/agents/EXAMPLE_AGENT_ID/webhook
CURSOR_WEBHOOK_KEY=EXAMPLE_WEBHOOK_BEARER_TOKEN

# Comma-separated E.164 numbers allowed to wake the bot (optional but recommended)
ALLOWLIST=+15551234567

# Linq webhook signing secret (REQUIRED for production)
# Get from: linq webhooks create --url <url> --events message.received
# Format: whsec_... (Standard Webhooks) or raw secret (legacy)
LINQ_WEBHOOK_SECRET=whsec_EXAMPLE_SECRET

# Security options
# Set to "1" to enforce signature verification (recommended for production)
REQUIRE_LINQ_SIGNATURE=1

# Set to "1" to allow unsigned webhooks in development (NOT recommended for production)
# Only use this for local testing without a signing secret
# ALLOW_UNSIGNED_WEBHOOKS=1
