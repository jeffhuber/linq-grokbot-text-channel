# Cursor agent webhook (from Cursor → Agents → your bot → Webhooks)
CURSOR_WEBHOOK_URL=https://api.cursor.com/v0/agents/EXAMPLE_AGENT_ID/webhook
CURSOR_WEBHOOK_KEY=EXAMPLE_WEBHOOK_BEARER_TOKEN

# Comma-separated E.164 numbers allowed to wake the bot (optional but recommended)
ALLOWLIST=+15551234567
